{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kvynlim.github.io/industry-research/schemas/runtime-map-contract.schema.json",
  "title": "Runtime Map Contract",
  "description": "Machine-readable contract for the runtime map export consumed by Autoware or an equivalent AV stack.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "runtime_map_contract_id",
    "target_stack",
    "map_contract_version",
    "target_container_digest",
    "paths",
    "projection",
    "pointcloud_loader",
    "loader_evidence",
    "signatures_provenance",
    "compatibility"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "runtime-map-contract/v1"
    },
    "runtime_map_contract_id": {
      "type": "string",
      "minLength": 1
    },
    "target_stack": {
      "type": "string",
      "enum": ["autoware", "custom"]
    },
    "map_contract_version": {
      "type": "string",
      "minLength": 1
    },
    "target_container_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "paths": {
      "type": "object",
      "additionalProperties": false,
      "required": ["map_path", "lanelet2_map_path", "pointcloud_map_path", "pointcloud_map_metadata_path", "map_projector_info_path"],
      "properties": {
        "map_path": { "type": "string", "minLength": 1 },
        "lanelet2_map_path": { "type": "string", "minLength": 1 },
        "pointcloud_map_path": { "type": "string", "minLength": 1 },
        "pointcloud_map_metadata_path": { "type": "string", "minLength": 1 },
        "map_projector_info_path": { "type": "string", "minLength": 1 }
      }
    },
    "projection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projector_type", "datum", "map_projector_info_hash"],
      "properties": {
        "projector_type": {
          "type": "string",
          "enum": ["local", "mgrs", "utm", "transverse_mercator"]
        },
        "datum": { "type": "string", "minLength": 1 },
        "mgrs_grid": { "type": "string", "minLength": 1 },
        "utm_zone": { "type": "string", "minLength": 1 },
        "origin": {
          "type": "object",
          "additionalProperties": false,
          "required": ["latitude", "longitude", "altitude_m"],
          "properties": {
            "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
            "longitude": { "type": "number", "minimum": -180, "maximum": 180 },
            "altitude_m": { "type": "number" }
          }
        },
        "map_projector_info_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      }
    },
    "pointcloud_loader": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pcd_fields",
        "pcd_resolution_m",
        "pcd_split_size_m",
        "pointcloud_map_metadata_hash",
        "axis_aligned",
        "non_overlapping",
        "projection_consistent",
        "loader_cells"
      ],
      "properties": {
        "pcd_fields": {
          "type": "array",
          "minItems": 3,
          "items": { "type": "string", "minLength": 1 }
        },
        "pcd_resolution_m": { "type": "number", "minimum": 0 },
        "pcd_split_size_m": { "type": "number", "minimum": 0 },
        "pointcloud_map_metadata_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "axis_aligned": { "type": "boolean" },
        "non_overlapping": { "type": "boolean" },
        "projection_consistent": { "type": "boolean" },
        "loader_cells": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["cell_id", "pcd_hash", "point_count", "bounds"],
            "properties": {
              "cell_id": { "type": "string", "minLength": 1 },
              "pcd_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
              "point_count": { "type": "integer", "minimum": 0 },
              "bounds": {
                "type": "object",
                "additionalProperties": false,
                "required": ["min_x", "min_y", "min_z", "max_x", "max_y", "max_z"],
                "properties": {
                  "min_x": { "type": "number" },
                  "min_y": { "type": "number" },
                  "min_z": { "type": "number" },
                  "max_x": { "type": "number" },
                  "max_y": { "type": "number" },
                  "max_z": { "type": "number" }
                }
              }
            }
          }
        }
      }
    },
    "loader_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lanelet2_loader_evidence_id", "pointcloud_loader_evidence_id"],
      "properties": {
        "lanelet2_loader_evidence_id": { "type": "string", "minLength": 1 },
        "pointcloud_loader_evidence_id": { "type": "string", "minLength": 1 },
        "dynamic_load_replay_evidence_id": { "type": "string", "minLength": 1 }
      }
    },
    "signatures_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_digest", "signed_release_manifest_id", "signer_id", "slsa_provenance_ref", "uptane_metadata_ref"],
      "properties": {
        "contract_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "signed_release_manifest_id": { "type": "string", "minLength": 1 },
        "signer_id": { "type": "string", "minLength": 1 },
        "slsa_provenance_ref": { "type": "string", "minLength": 1 },
        "uptane_metadata_ref": { "type": "string", "minLength": 1 }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtime_compatibility_hash", "semantic_manifest_id"],
      "properties": {
        "runtime_compatibility_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "semantic_manifest_id": { "type": "string", "minLength": 1 }
      }
    }
  }
}
